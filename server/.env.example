# SummonScroll — Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Neon (recommended): postgresql://user:password@ep-xxx.neon.tech/summonscroll?sslmode=require
# Local:              postgresql://postgres:postgres@localhost:5432/summonscroll
DATABASE_URL="postgresql://user:password@localhost:5432/summonscroll"

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET="CHANGE-ME-generate-with-openssl-rand-hex-32"
JWT_REFRESH_SECRET="CHANGE-ME-generate-with-openssl-rand-hex-32"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Development: http://localhost:5173,http://localhost:5174,http://localhost:5175
# Production:  https://your-vercel-app.vercel.app
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# ── WebSocket (optional) ──────────────────────────────────────────────────────
# WebSocket server port (leave empty to use same port as HTTP server)
WS_PORT=3002

# ── Icon Storage (optional) ───────────────────────────────────────────────────
# Local: ./public/icons
# Cloud: https://your-cdn.com/icons
ICON_STORAGE_PATH="./public/icons"
ICON_STORAGE_URL="http://localhost:3001/icons"

# ── Monitoring (optional) ─────────────────────────────────────────────────────
# Sentry DSN for error tracking — leave empty to disable
# Get from: https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=""

# ── Database Connection Pool (optional) ───────────────────────────────────────
# Connection pool configuration
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT=5000
DB_IDLE_TIMEOUT=30000

# ── Logging (optional) ────────────────────────────────────────────────────────
# Log level: debug, info, warn, error
LOG_LEVEL="info"
