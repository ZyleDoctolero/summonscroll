# Test Environment Variables
# This file is used when running tests

# ── Database ──────────────────────────────────────────────────────────────────
# IMPORTANT: Use a separate test database to avoid data loss
# The test suite will clean up data after each test
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/summonscroll_test"

# ── JWT Secrets ───────────────────────────────────────────────────────────────
JWT_SECRET="test-secret-key-min-32-characters-long-for-testing"
JWT_REFRESH_SECRET="test-refresh-secret-key-min-32-characters-long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV="test"

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:5173"

# ── WebSocket ─────────────────────────────────────────────────────────────────
WS_PORT=3002

# ── Icon Storage ──────────────────────────────────────────────────────────────
ICON_STORAGE_PATH="./public/icons"
ICON_STORAGE_URL="http://localhost:3001/icons"

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=""

# ── Database Connection Pool ──────────────────────────────────────────────────
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT=5000
DB_IDLE_TIMEOUT=30000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL="error"
