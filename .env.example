# SummonScroll — Frontend Environment Variables
# Copy this file to .env and fill in your values.
# VITE_ prefix is required for variables exposed to the browser.

# Backend API base URL
# Development: http://localhost:3001/api
# Production:  https://your-railway-app.railway.app/api
VITE_API_URL="http://localhost:3001/api"

# Sentry DSN for frontend error tracking (optional — leave empty to disable)
# Get from: https://sentry.io → Project Settings → Client Keys
VITE_SENTRY_DSN=""
