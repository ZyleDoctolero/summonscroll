// SummonScroll — Prisma Schema
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Rarity {
  common
  uncommon
  rare
  epic
  legendary
  mythic
  ex
}

enum Element {
  fire
  water
  earth
  wind
  light
  dark
  void
  digital
  ice
  thunder
  nature
  stellar
  primordial
  synthetic
  // Realm-specific elements
  arcane
  chaos
  dread
  death
  divine
}

enum MonsterRole {
  attacker
  tank
  healer
  debuffer
  support
}

enum AwakeningStage {
  ZERO
  ONE
  TWO
  THREE
  FOUR
  FIVE
}

enum CorruptionState {
  pure
  corrupted
  divine
  hollow
}

enum RankForm {
  standard
  champion
  sovereign
}

enum BannerType {
  standard
  featured
  streak
  pact_seal
  event
}

enum HabitDifficulty {
  trivial
  easy
  medium
  hard
}

enum HabitCategory {
  study
  fitness
  meditation
  sleep
  nutrition
  productivity
  custom
}

enum SkinType {
  seasonal
  event
  achievement
  default
}

enum BattleMode {
  dungeon
  chaos_tower
  guild_raid
  event
}

enum ShopItemType {
  consumable
  material
  skin
  currency_pack
}

// ─── Realm ────────────────────────────────────────────────────────────────────

model Realm {
  id             String   @id @default(uuid())
  number         Int      @unique
  name           String
  slug           String   @unique
  element        Element
  habitAffinity  HabitCategory[]
  description    String
  colorHex       String
  createdAt      DateTime @default(now())

  monsters       Monster[]
  banners        Banner[]
  exMonsterLog   ExMonsterLog[]
}

// ─── Monster ──────────────────────────────────────────────────────────────────

model Monster {
  id          String      @id @default(uuid())
  name        String
  realmId     String
  realm       Realm       @relation(fields: [realmId], references: [id])
  rarity      Rarity
  role        MonsterRole
  element     Element
  origin      String
  lore        String      @default("")
  artUrl      String?
  isEx        Boolean     @default(false)
  realmSkill  String?
  baseHp      Int         @default(1000)
  baseAtk     Int         @default(100)
  baseDef     Int         @default(80)
  baseSpd     Int         @default(90)
  bannerType  BannerType  @default(standard)
  createdAt   DateTime    @default(now())

  skills       Skill[]
  userMonsters UserMonster[]
  skins        MonsterSkin[]
  exLog        ExMonsterLog?
  fusionResultOf FusionRecipe[] @relation("FusionResult")
  fusionIngredientOf FusionIngredient[]

  @@index([realmId])
  @@index([rarity])
  @@index([element])
  @@index([isEx])
}

// ─── Skill ────────────────────────────────────────────────────────────────────

model Skill {
  id                 String   @id @default(uuid())
  monsterId          String
  monster            Monster  @relation(fields: [monsterId], references: [id], onDelete: Cascade)
  name               String
  description        String
  slot               Int      // 1–4 (slot 4 = EX Realm Skill only)
  unlockBondPercent  Int      @default(0)
  cooldown           Int      @default(0)
  element            Element?
}

// ─── Monster Skin ─────────────────────────────────────────────────────────────

model MonsterSkin {
  id               String   @id @default(uuid())
  monsterId        String
  monster          Monster  @relation(fields: [monsterId], references: [id], onDelete: Cascade)
  skinName         String
  skinType         SkinType
  isSeasonal       Boolean  @default(false)
  unlockCondition  String?
  artUrl           String?

  userSkins        UserSkin[]
}

// ─── EX Monster Log ───────────────────────────────────────────────────────────

model ExMonsterLog {
  monsterId                  String   @id
  monster                    Monster  @relation(fields: [monsterId], references: [id])
  realmId                    String
  realm                      Realm    @relation(fields: [realmId], references: [id])
  firstPulledById            String?
  firstPulledBy              User?    @relation(fields: [firstPulledById], references: [id])
  timesPulled                Int      @default(0)
  transcendenceStonesIssued  Int      @default(0)
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(uuid())
  username        String   @unique
  email           String   @unique
  passwordHash    String
  level           Int      @default(1)
  xp              Int      @default(0)
  xpToNextLevel   Int      @default(1000)
  spiritCrystals  Int      @default(100)
  voidShards      Int      @default(5)
  pactSeals       Int      @default(0)
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  avatarUrl       String?
  guildId         String?
  guild           Guild?   @relation(fields: [guildId], references: [id])
  refreshToken    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  monsters        UserMonster[]
  habits          Habit[]
  dailies         Daily[]
  todos           Todo[]
  battleResults   BattleResult[]
  userSkins       UserSkin[]
  exFirstPulls    ExMonsterLog[]
  loginRewards    LoginReward[]

  @@index([email])
  @@index([username])
  @@index([guildId])
}

// ─── User Monster ─────────────────────────────────────────────────────────────

model UserMonster {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  monsterId       String
  monster         Monster         @relation(fields: [monsterId], references: [id])
  level           Int             @default(1)
  awakeningStage  Int             @default(0) // 0–5
  corruptionState CorruptionState @default(pure)
  rankForm        RankForm        @default(standard)
  bondXp          Int             @default(0)
  bondPercent     Int             @default(0) // 0–100
  equippedSkinId  String?
  isOnTeam        Boolean         @default(false)
  teamSlot        Int?            // 1–5
  acquiredAt      DateTime        @default(now())

  @@unique([userId, monsterId, awakeningStage, corruptionState, rankForm])
  @@index([userId])
  @@index([monsterId])
  @@index([userId, isOnTeam])
}

// ─── User Skin ────────────────────────────────────────────────────────────────

model UserSkin {
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  skinId      String
  skin        MonsterSkin @relation(fields: [skinId], references: [id])
  equippedOn  String?     // UserMonster.id

  @@id([userId, skinId])
}

// ─── Habit ────────────────────────────────────────────────────────────────────

model Habit {
  id                 String          @id @default(uuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  category           HabitCategory   @default(custom)
  difficulty         HabitDifficulty @default(medium)
  streakCount        Int             @default(0)
  streakHealth       Int             @default(100)
  lastCompletedAt    DateTime?
  isActive           Boolean         @default(true)
  questFrameEnabled  Boolean         @default(false)
  questDeadline      DateTime?
  realmAffinity      Int?            // realm number 1–12
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([userId, isActive])
}

// ─── Daily ────────────────────────────────────────────────────────────────────

model Daily {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  category        HabitCategory   @default(custom)
  difficulty      HabitDifficulty @default(medium)
  completedToday  Boolean         @default(false)
  streakCount     Int             @default(0)
  dueTime         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, completedToday])
}

// ─── Todo ─────────────────────────────────────────────────────────────────────

model Todo {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  difficulty  HabitDifficulty @default(medium)
  isCompleted Boolean         @default(false)
  dueDate     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// ─── Banner ───────────────────────────────────────────────────────────────────

model Banner {
  id                String     @id @default(uuid())
  name              String
  bannerType        BannerType
  realmId           String?
  realm             Realm?     @relation(fields: [realmId], references: [id])
  featuredMonsterId String?
  artUrl            String?
  startsAt          DateTime
  endsAt            DateTime
  isActive          Boolean    @default(true)
  pullCost          Int        @default(160)
  pullCurrency      String     @default("spiritCrystals")

  @@index([isActive])
  @@index([bannerType])
  @@index([startsAt, endsAt])
}

// ─── Battle Result ────────────────────────────────────────────────────────────

model BattleResult {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode            BattleMode
  won             Boolean
  floorReached    Int?
  crystalsEarned  Int        @default(0)
  shardsEarned    Int        @default(0)
  xpEarned        Int        @default(0)
  completedAt     DateTime   @default(now())

  @@index([userId, completedAt])
}

// ─── Fusion Recipe ────────────────────────────────────────────────────────────

model FusionRecipe {
  id              String   @id @default(uuid())
  resultMonsterId String
  resultMonster   Monster  @relation("FusionResult", fields: [resultMonsterId], references: [id])
  isCrossRealm    Boolean  @default(false)
  successRate     Int      @default(100) // percentage

  ingredients     FusionIngredient[]
}

model FusionIngredient {
  id        String       @id @default(uuid())
  recipeId  String
  recipe    FusionRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  monsterId String
  monster   Monster      @relation(fields: [monsterId], references: [id])
  slot      Int          // 1, 2, or 3
}

// ─── Guild ────────────────────────────────────────────────────────────────────

model Guild {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String   @default("")
  raidBossHp      Int      @default(1000000)
  raidBossMaxHp   Int      @default(1000000)
  createdAt       DateTime @default(now())

  members         User[]
}

// ─── Shop Item ────────────────────────────────────────────────────────────────

model ShopItem {
  id            String       @id @default(uuid())
  name          String
  description   String
  itemType      ShopItemType
  cost          Int
  costCurrency  String       @default("spiritCrystals")
  quantity      Int          @default(1)
  limitedUntil  DateTime?
  artUrl        String?
  isActive      Boolean      @default(true)
  tab           String       @default("daily") // daily | featured | packs
  createdAt     DateTime     @default(now())
}

// ─── Login Reward ─────────────────────────────────────────────────────────────

model LoginReward {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day         Int      // 1–7
  claimedAt   DateTime @default(now())
  weekStart   DateTime // start of the 7-day cycle
}

// ─── Currency Icon ────────────────────────────────────────────────────────────

model CurrencyIcon {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  type        String   @default("currency")
  url         String
  format      String   @default("svg")
  width       Int      @default(64)
  height      Int      @default(64)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([name])
}
